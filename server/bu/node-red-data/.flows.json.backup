        "type": "function",
        "z": "063c39e50bf80931",
        "name": "extract data",
        "func": "// Проверяем, что массив не пустой\nif (msg.payload && msg.payload.length > 0) {\n    // Извлекаем число 624 из первого элемента массива\n    let maxValue = msg.payload[0].bigest_value_ever;\n    \n    // Формируем сообщение для отображения\n    msg.payload = maxValue; \n    // Можно добавить подпись, которая появится в виджете\n    msg.topic = \"Max recorded value\"; \n} else {\n    msg.payload = \"No data\";\n}\n\nreturn msg;",
