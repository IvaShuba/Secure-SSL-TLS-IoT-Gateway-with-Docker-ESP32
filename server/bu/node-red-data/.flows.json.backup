    {
        "id": "d0efcf2262e26a80",
        "type": "function",
        "z": "063c39e50bf80931",
        "name": "extract data",
        "func": "// Проверяем, что массив не пустой\nif (msg.payload && msg.payload.length > 0) {\n    // Извлекаем число 624 из первого элемента массива\n    let minValue = msg.payload[0].lowest_value_ever;\n    \n    // Формируем сообщение для отображения\n    msg.payload = minValue; \n    // Можно добавить подпись, которая появится в виджете\n    msg.topic = \"Minimum recorded value\"; \n} else {\n    msg.payload = \"No data\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 140,
        "wires": [
            [
                "4488c80be1f52934"
            ]
        ]
    },
    {
        "id": "f2b26ad24693339d",
        "type": "function",
        "z": "063c39e50bf80931",
        "name": "db to chart",
        "func": "// 1. Проверяем, что из базы что-то пришло и это массив\nlet docs = msg.payload;\n//if (!Array.isArray(docs)) return null;\n\n// 2. Формируем массив точек для графика\nlet chartData = docs.map(doc => {\n    return {\n        \"topic\": \"Median Value\", // Имя линии на графике\n        \"payload\": doc.median_val, // Значение из твоей плоской структуры\n        \"timestamp\": new Date(doc.timestamp).getTime() // Время в мс\n    };\n});\n\n// 3. Чтобы график отобразил всё сразу, отправляем массив в одном сообщении\nmsg.payload = [\n    {\n        \"series\": [\"Median Value\"],\n        \"data\": [chartData],\n        \"labels\": [\"Median Value\"]\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 910,
        "y": 320,
        "wires": [
            [
                "391046dee52e51ec"
            ]
        ]
    },
