    {
        "id": "978449da3c80d25f",
        "type": "mqtt in",
        "z": "64170af31f558f88",
        "name": "",
        "topic": "gateway/telemetry",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "078f390b726e93b9",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 330,
        "y": 120,
        "wires": [
            [
                "3c0b94b96d7782c6"
            ]
        ]
    },
    {
        "id": "3c0b94b96d7782c6",
        "type": "function",
        "z": "64170af31f558f88",
        "name": "function 1",
        "func": "// Очищаем структуру, чтобы в базу летел плоский и понятный объект\nlet data = msg.payload;\nconst src = data.payload || data;\n\n// 2. Safely extract the timestamp\nlet rawTimestamp = src.timestamp;\n\n// 3. Create a valid JS Date object\nlet validBsonDate;\n\nif (rawTimestamp) {\n    validBsonDate = new Date(rawTimestamp);\n    \n    // Check if the provided timestamp was valid. \n    // If it produced \"Invalid Date\", fallback to current time.\n    if (isNaN(validBsonDate.getTime())) {\n        validBsonDate = new Date();\n        node.warn(`Invalid timestamp format received: \"${rawTimestamp}\". Fallback to current time.`);\n    }\n} else {\n    // If timestamp is completely missing, use current time\n    validBsonDate = new Date();\n}\n\n// 4. Construct the final payload\nmsg.payload = {\n    \"sensor_id\": src.sensor_id,\n    \"device_name\": src.device_name,\n    \"type\": src.type,\n    \"value\": src.value,\n    \"note\": src.note || \"normal\",\n    \"timestamp\": validBsonDate // Now guaranteed to be a valid BSON UTC datetime\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 120,
        "wires": [
            [
                "e2f44fe6411a66f6"
            ]
        ]
    },
    {
        "id": "e2f44fe6411a66f6",
        "type": "mongodb out",
        "z": "64170af31f558f88",
        "mongodb": "22836561e3395119",
        "name": "",
        "collection": "sensor_data2",
        "payonly": true,
        "upsert": false,
        "multi": false,
        "operation": "insert",
        "x": 910,
        "y": 120,
        "wires": []
    },
    {
        "id": "c6b0f68ce493aa5d",
        "type": "function",
        "z": "92155914ae69ddd9",
        "name": "function 2",
        "func": "// 1. Берем интервал дат из запроса Grafana\nlet from = new Date(msg.payload.range.from);\nlet to = new Date(msg.payload.range.to);\n\n// 2. Сохраняем имя запрошенной метрики в msg для следующего шага\nmsg.targetMetric = msg.payload.targets[0].target;\n\n// 3. Формируем запрос для MongoDB Find\nmsg.payload = {\n    \"timestamp\": { \"$gte\": from, \"$lte\": to }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [
            [
                "3ec66e0df709bfce"
            ]
        ]
    },
    {
        "id": "3ec66e0df709bfce",
        "type": "mongodb in",
        "z": "92155914ae69ddd9",
        "mongodb": "22836561e3395119",
        "name": "",
        "collection": "sensor_data",
        "operation": "aggregate",
        "x": 670,
        "y": 180,
        "wires": [
            [
                "34d15d2f2fab0a2e"
            ]
        ]
    },
    {
        "id": "34d15d2f2fab0a2e",
        "type": "function",
        "z": "92155914ae69ddd9",
        "name": "function 3",
        "func": "let docs = msg.payload; // Массив из базы\nlet target = msg.targetMetric; // median_val или другая\n\n// Форматируем в массив [значение, время_в_мс]\nlet datapoints = docs.map(doc => {\n    return [\n        Number(doc[target]),\n        new Date(doc.timestamp).getTime()\n    ];\n});\n\n// Финальный ответ для Grafana\nmsg.payload = [\n    {\n        \"target\": target,\n        \"datapoints\": datapoints\n    }\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 180,
        "wires": [
            [
                "997eb687f211ab16"
            ]
        ]
    },
