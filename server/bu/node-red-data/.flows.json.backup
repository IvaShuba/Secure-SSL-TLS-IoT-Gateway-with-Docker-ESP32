        "type": "function",
        "z": "063c39e50bf80931",
        "name": "extract data",
        "func": "// Check if we got any data from Mongo\nif (msg.payload && msg.payload.length > 0) {\n    // Get the first (and only) document from the array\n    let lastDoc = msg.payload[0];\n    \n    // Extract the specific value\n    msg.payload = lastDoc.median_val;\n    msg.topic = \"Last Median Value\";\n} else {\n    msg.payload = \"No records in DB\";\n}\n\nreturn msg;",
